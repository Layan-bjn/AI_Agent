{
  // Display name for this crew
  "name": "AI_Agent",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["ai_investment_assistance"],

  "tasks": [
    {
      "name": "evaluate_and_match_incubator_task",


"description": "Evaluate the idea: '{project_idea}'. Step 1: Use FileReadTool once on 'knowledge/startup.json' to check feasibility. Step 2: If feasible, run exactly ONE search query with SerperDevTool to find the top matching Saudi incubator or companies. If not feasible, skip search and write a rejection reason.",

"expected_output": "A concise report: (1) Verdict (PASS/FAIL with brief rationale). (2) If PASS: Best incubator/companies found. If FAIL: Rejection message.",

      "guardrail": "Output must contain no markdown formatting characters (*, #, _, `). It must be organized into clearly labeled, numbered sections exactly as described in expected_output. Section 2 must contain the literal word 'PASS' or 'FAIL'. If the verdict is FAIL, the output must NOT contain any incubator names or an application payload. If the verdict is PASS, the output must contain at least one specific incubator name backed by a web search result, plus a draft application payload — never an invented incubator. Every factual claim about incubators must trace back to a SerperDevTool result or the knowledge file.",

      "guardrail_max_retries": 2,
      "markdown": false,
      "agent": "ai_investment_assistance",

      // Web search tool for finding real KSA incubators/accelerators
      "tools": ["SerperDevTool"]
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,
  "max_rpm": 5,
  "cache": true,

  // Runtime input — crewai run will prompt for this if not filled in here
  // {project_idea} is used inside the task description above
  "inputs": {
    "project_idea": "A mobile app that connects Saudi university students with local farmers to reduce food waste by rescuing unsold produce at discounted prices."
  }
}