{
  "name": "AI_Agent",

  "agents": [
    "investment_orchestrator",
    "feasibility_agent",
    "startup_matching_agent",
    "incubator_agent",
    "quality_control_agent"
  ],

  "tasks": [
    {
      "name": "feasibility_task",

      "description": "Evaluate the student's project idea: {project_idea}. Assess technical feasibility and commercial feasibility. Identify the main technical risks, commercial risks, and overall feasibility. Return a structured PASS or FAIL verdict.",

      "expected_output": "A structured feasibility assessment containing technical_score, commercial_score, overall_score, verdict, and primary_reason.",

      "agent": "feasibility_agent",

      "tools": []
    },

    {
      "name": "startup_matching_task",

      "description": "Only execute this task when the feasibility verdict is PASS. Read knowledge/startup.json using FileReadTool. Compare the student's project with the startups in the file using domain, technologies, problem, target market, and use-case similarity. If a relevant startup exists, select exactly one startup and return its exact name as written in startup.json. Do not invent or modify startup names. Do not perform web searches.",

      "expected_output": "A structured startup matching result containing match_found, startup_name, and justification.",

      "agent": "startup_matching_agent",

      "tools": ["FileReadTool"]
    },

    {
      "name": "incubator_task",

      "description": "Only execute this task when the feasibility verdict is PASS and the startup matching agent found zero relevant startups. Use SerperDevTool exactly once to find one active Saudi Arabian incubator or accelerator relevant to the student's project. Return exactly two most relevant recommended incubator or accelerator.",

      "expected_output": "A structured incubator recommendation containing incubator_name, justification, and source.",

      "agent": "incubator_agent",

      "tools": ["SerperDevTool"]
    },

    {
      "name": "quality_control_task",

      "description": "Review the outputs from the feasibility, startup matching, and incubator agents. Verify that the workflow was followed correctly. If FAIL, there must be no startup or incubator recommendation. If PASS with a startup match, there must be exactly one  startup recommendations and no incubator. If PASS with no startup match, there must be exactly two most relevant incubator recommendations. Do not invent missing information.",

      "expected_output": "A validated final report with Idea Summary, Verdict, and Recommendation or rejection reason.",

      "agent": "quality_control_agent",

      "tools": []
    }
  ],

  "process": "hierarchical",

  "verbose": true,

  "memory": false,

  "max_rpm": 5,

  "cache": false,

  "inputs": {
    "project_idea": "An AI-powered edge computing platform that integrates with existing industrial HVAC systems to dynamically optimize power consumption in commercial facilities, leveraging Saudi smart grid APIs and carbon credit monetization."
  }
}